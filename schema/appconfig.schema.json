{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "wgModelHub AppConfig",
  "type": "object",
  "required": ["database", "providers", "logfire"],
  "properties": {
    "database": { "$ref": "#/definitions/database" },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^\\S(?:.*\\S)?$": { "$ref": "#/definitions/provider" }
      }
    },
    "model_routes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\S(?:.*\\S)?$": { "type": "string", "minLength": 1 }
      }
    },
    "logfire": { "$ref": "#/definitions/logfire" }
  },
  "definitions": {
    "database": {
      "type": "object",
      "required": ["dsn"],
      "properties": {
        "dsn": { "type": "string", "minLength": 1 }
      }
    },
    "logfire": {
      "type": "object",
      "required": ["token"],
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "env": { "type": "string" },
        "service": { "type": "string" },
        "version": { "type": "string" },
        "otel_log_level": { "type": "string" }
      }
    },
    "provider": {
      "type": "object",
      "required": ["models"],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "gemini": { "$ref": "#/definitions/gemini" },
        "vertexai": { "$ref": "#/definitions/vertexai" },
        "ark": { "$ref": "#/definitions/ark" },
        "openai": { "$ref": "#/definitions/openai" },
        "ltx": { "$ref": "#/definitions/ltx" },
        "dashscope_video": { "$ref": "#/definitions/dashscopeVideo" },
        "ominilink_video": { "$ref": "#/definitions/ominilinkVideo" },
        "gemini_video": { "$ref": "#/definitions/geminiVideo" },
        "ark_video": { "$ref": "#/definitions/arkVideo" },
        "minimax_tts": { "$ref": "#/definitions/minimaxTts" },
        "elevenlabs_tts": { "$ref": "#/definitions/elevenlabsTts" },
        "photoroom": { "$ref": "#/definitions/photoroom" },
        "segment_person": { "$ref": "#/definitions/segmentPerson" },
        "human_yolo": { "$ref": "#/definitions/humanYolo" },
        "human_parser": { "$ref": "#/definitions/humanParser" },
        "rekognition_detect": { "$ref": "#/definitions/rekognitionDetect" },
        "facebody_compare": { "$ref": "#/definitions/facebodyCompare" },
        "rekognition_compare": { "$ref": "#/definitions/rekognitionCompare" },
        "dashscope_embedding": { "$ref": "#/definitions/dashscopeEmbedding" },
        "cohere_embedding": { "$ref": "#/definitions/cohereEmbedding" },
        "bedrock_embedding": { "$ref": "#/definitions/bedrockEmbedding" },
        "dashscope_rerank": { "$ref": "#/definitions/dashscopeRerank" },
        "bedrock_rerank": { "$ref": "#/definitions/bedrockRerank" },
        "cohere_rerank": { "$ref": "#/definitions/cohereRerank" },
        "facebody_detect": { "$ref": "#/definitions/facebodyDetect" },
        "facebody_library": { "$ref": "#/definitions/facebodyLibrary" },
        "rekognition_faces": { "$ref": "#/definitions/rekognitionFaces" },
        "rekognition_library": { "$ref": "#/definitions/rekognitionLibrary" }
      },
      "oneOf": [
        { "required": ["gemini"] },
        { "required": ["vertexai"] },
        { "required": ["ark"] },
        { "required": ["openai"] },
        { "required": ["ltx"] },
        { "required": ["dashscope_video"] },
        { "required": ["ominilink_video"] },
        { "required": ["gemini_video"] },
        { "required": ["ark_video"] },
        { "required": ["minimax_tts"] },
        { "required": ["elevenlabs_tts"] },
        { "required": ["photoroom"] },
        { "required": ["segment_person"] },
        { "required": ["human_yolo"] },
        { "required": ["human_parser"] },
        { "required": ["rekognition_detect"] },
        { "required": ["facebody_compare"] },
        { "required": ["rekognition_compare"] },
        { "required": ["dashscope_embedding"] },
        { "required": ["cohere_embedding"] },
        { "required": ["bedrock_embedding"] },
        { "required": ["dashscope_rerank"] },
        { "required": ["bedrock_rerank"] },
        { "required": ["cohere_rerank"] },
        { "required": ["facebody_detect"] },
        { "required": ["facebody_library"] },
        { "required": ["rekognition_faces"] },
        { "required": ["rekognition_library"] }
      ]
    },
    "gemini": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "proxy_url": { "type": "string" }
      }
    },
    "vertexai": {
      "type": "object",
      "required": ["project", "location"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "ark": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "endpoint_id": { "type": "string" }
      }
    },
    "openai": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" }
      }
    },
    "ltx": {
      "type": "object",
      "required": ["base_url", "duration", "fps", "poll_interval", "max_poll_time"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "token": { "type": "string" },
        "duration": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
        "fps": { "type": "integer", "minimum": 0, "exclusiveMinimum": true },
        "seed": { "type": "integer" },
        "poll_interval": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
        "max_poll_time": { "type": "number", "minimum": 0, "exclusiveMinimum": true }
      }
    },
    "dashscopeVideo": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "poll_interval": { "type": "number", "minimum": 0 },
        "max_poll_time": { "type": "number", "minimum": 0 }
      }
    },
    "ominilinkVideo": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "poll_interval": { "type": "number", "minimum": 0 },
        "max_poll_time": { "type": "number", "minimum": 0 }
      }
    },
    "geminiVideo": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "proxy_url": { "type": "string" },
        "auth_header": { "type": "string" },
        "poll_interval": { "type": "number", "minimum": 0 }
      }
    },
    "arkVideo": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "poll_interval": { "type": "number", "minimum": 0 },
        "max_poll_time": { "type": "number", "minimum": 0 }
      }
    },
    "photoroom": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" }
      }
    },
    "minimaxTts": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string" },
        "language_boost": { "type": "string" },
        "voice_id": { "type": "string" },
        "speed": { "type": "number" },
        "volume": { "type": "number" },
        "pitch": { "type": "integer" }
      }
    },
    "elevenlabsTts": {
      "type": "object",
      "required": ["api_key", "voice_id"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "voice_id": { "type": "string", "minLength": 1 }
      }
    },
    "segmentPerson": {
      "type": "object",
      "required": ["base_url", "method"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "humanYolo": {
      "type": "object",
      "required": ["base_url", "username", "password"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 }
      }
    },
    "humanParser": {
      "type": "object",
      "required": ["base_url"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "rekognitionDetect": {
      "type": "object",
      "required": ["region"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "access_key_id": { "type": "string" },
        "access_key_secret": { "type": "string" },
        "session_token": { "type": "string" }
      }
    },
    "facebodyCompare": {
      "type": "object",
      "required": ["endpoint", "access_key_id", "access_key_secret"],
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 },
        "access_key_id": { "type": "string", "minLength": 1 },
        "access_key_secret": { "type": "string", "minLength": 1 }
      }
    },
    "rekognitionCompare": {
      "type": "object",
      "required": ["region"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "access_key_id": { "type": "string" },
        "access_key_secret": { "type": "string" },
        "session_token": { "type": "string" }
      }
    },
    "dashscopeEmbedding": {
      "type": "object",
      "required": ["base_url", "api_key"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "api_key": { "type": "string", "minLength": 1 }
      }
    },
    "cohereEmbedding": {
      "type": "object",
      "required": ["base_url", "api_key"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "api_key": { "type": "string", "minLength": 1 }
      }
    },
    "bedrockEmbedding": {
      "type": "object",
      "required": ["region"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "role_arn": { "type": "string" }
      }
    },
    "dashscopeRerank": {
      "type": "object",
      "required": ["base_url", "api_key"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "api_key": { "type": "string", "minLength": 1 }
      }
    },
    "cohereRerank": {
      "type": "object",
      "required": ["base_url", "api_key"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "api_key": { "type": "string", "minLength": 1 }
      }
    },
    "bedrockRerank": {
      "type": "object",
      "required": ["region"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "role_arn": { "type": "string" }
      }
    },
    "facebodyDetect": {
      "type": "object",
      "required": ["endpoint", "access_key_id", "access_key_secret"],
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 },
        "access_key_id": { "type": "string", "minLength": 1 },
        "access_key_secret": { "type": "string", "minLength": 1 }
      }
    },
    "facebodyLibrary": {
      "type": "object",
      "required": ["endpoint", "access_key_id", "access_key_secret", "database"],
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 },
        "access_key_id": { "type": "string", "minLength": 1 },
        "access_key_secret": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 }
      }
    },
    "rekognitionFaces": {
      "type": "object",
      "required": ["region"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "access_key_id": { "type": "string" },
        "access_key_secret": { "type": "string" },
        "session_token": { "type": "string" }
      }
    },
    "rekognitionLibrary": {
      "type": "object",
      "required": ["region", "collection"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "access_key_id": { "type": "string" },
        "access_key_secret": { "type": "string" },
        "session_token": { "type": "string" },
        "collection": { "type": "string", "minLength": 1 }
      }
    }
  }
}
