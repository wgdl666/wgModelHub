{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "wgModelHub AppConfig",
  "type": "object",
  "required": ["database", "providers", "logfire"],
  "properties": {
    "database": { "$ref": "#/definitions/database" },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^\\S(?:.*\\S)?$": { "$ref": "#/definitions/provider" }
      }
    },
    "model_routes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\S(?:.*\\S)?$": { "type": "string", "minLength": 1 }
      }
    },
    "logfire": { "$ref": "#/definitions/logfire" }
  },
  "definitions": {
    "database": {
      "type": "object",
      "required": ["dsn"],
      "properties": {
        "dsn": { "type": "string", "minLength": 1 }
      }
    },
    "logfire": {
      "type": "object",
      "required": ["token"],
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "env": { "type": "string" },
        "service": { "type": "string" },
        "version": { "type": "string" },
        "otel_log_level": { "type": "string" }
      }
    },
    "provider": {
      "type": "object",
      "required": ["models"],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "gemini": { "$ref": "#/definitions/gemini" },
        "vertexai": { "$ref": "#/definitions/vertexai" },
        "ark": { "$ref": "#/definitions/ark" },
        "openai": { "$ref": "#/definitions/openai" },
        "ltx": { "$ref": "#/definitions/ltx" },
        "dashscope_video": { "$ref": "#/definitions/dashscopeVideo" },
        "ominilink_video": { "$ref": "#/definitions/ominilinkVideo" },
        "gemini_video": { "$ref": "#/definitions/geminiVideo" },
        "ark_video": { "$ref": "#/definitions/arkVideo" },
        "minimax_tts": { "$ref": "#/definitions/minimaxTts" },
        "elevenlabs_tts": { "$ref": "#/definitions/elevenlabsTts" },
        "photoroom": { "$ref": "#/definitions/photoroom" },
        "segment_person": { "$ref": "#/definitions/segmentPerson" }
      },
      "oneOf": [
        { "required": ["gemini"] },
        { "required": ["vertexai"] },
        { "required": ["ark"] },
        { "required": ["openai"] },
        { "required": ["ltx"] },
        { "required": ["dashscope_video"] },
        { "required": ["ominilink_video"] },
        { "required": ["gemini_video"] },
        { "required": ["ark_video"] },
        { "required": ["minimax_tts"] },
        { "required": ["elevenlabs_tts"] },
        { "required": ["photoroom"] },
        { "required": ["segment_person"] }
      ]
    },
    "gemini": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "proxy_url": { "type": "string" }
      }
    },
    "vertexai": {
      "type": "object",
      "required": ["project", "location"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "ark": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "endpoint_id": { "type": "string" }
      }
    },
    "openai": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" }
      }
    },
    "ltx": {
      "type": "object",
      "required": ["base_url", "duration", "fps", "poll_interval", "max_poll_time"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "token": { "type": "string" },
        "duration": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
        "fps": { "type": "integer", "minimum": 0, "exclusiveMinimum": true },
        "seed": { "type": "integer" },
        "poll_interval": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
        "max_poll_time": { "type": "number", "minimum": 0, "exclusiveMinimum": true }
      }
    },
    "dashscopeVideo": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "poll_interval": { "type": "number", "minimum": 0 },
        "max_poll_time": { "type": "number", "minimum": 0 }
      }
    },
    "ominilinkVideo": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "poll_interval": { "type": "number", "minimum": 0 },
        "max_poll_time": { "type": "number", "minimum": 0 }
      }
    },
    "geminiVideo": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "proxy_url": { "type": "string" },
        "auth_header": { "type": "string" },
        "poll_interval": { "type": "number", "minimum": 0 }
      }
    },
    "arkVideo": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "poll_interval": { "type": "number", "minimum": 0 },
        "max_poll_time": { "type": "number", "minimum": 0 }
      }
    },
    "photoroom": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" }
      }
    },
    "minimaxTts": {
      "type": "object",
      "required": ["api_key"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string" },
        "language_boost": { "type": "string" },
        "voice_id": { "type": "string" },
        "speed": { "type": "number" },
        "volume": { "type": "number" },
        "pitch": { "type": "integer" }
      }
    },
    "elevenlabsTts": {
      "type": "object",
      "required": ["api_key", "voice_id"],
      "properties": {
        "api_key": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string" },
        "voice_id": { "type": "string", "minLength": 1 }
      }
    },
    "segmentPerson": {
      "type": "object",
      "required": ["base_url", "method"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "method": { "type": "string", "minLength": 1 }
      }
    }
  }
}
